<local:StorableWindow x:Class="Labelman8.AddTerminalMarkingTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Labelman8"
        Title="Добавить вид маркировки для клемм" 
        Height="500" Width="500"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Название -->
		<TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="0,5" Height="25" Text="1X5" TextChanged="Txt_TextChanged"/>

		<!-- Высота -->
		<TextBlock Grid.Row="1" Grid.Column="0" Text="Высота (мм):" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtHeight" Grid.Row="1" Grid.Column="1" Margin="0,5" Height="25" Text="10" TextChanged="Txt_TextChanged"/>

		<!-- Шаг -->
		<TextBlock Grid.Row="2" Grid.Column="0" Text="Шаг (мм):" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtPitch" Grid.Row="2" Grid.Column="1" Margin="0,5" Height="25" Text="5.2" TextChanged="Txt_TextChanged"/>

		<!-- Заголовок предпросмотра -->
		<TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="Предпросмотр:" FontWeight="Bold" Margin="0,10,0,5"/>

		<!-- Область предпросмотра -->
		<Border Grid.Row="4" Grid.ColumnSpan="2" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                Background="WhiteSmoke"
                Margin="0,0,0,10"
                MinHeight="150"
                x:Name="previewContainer">

			<Canvas x:Name="stickerCanvas"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    ClipToBounds="True">
				<!-- Содержимое будет добавляться в коде -->
			</Canvas>
		</Border>

		<!-- Кнопки -->
		<StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button x:Name="btnOk" Content="OK" Width="75" Height="25" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
			<Button x:Name="btnCancel" Content="Отмена" Width="75" Height="25" Click="BtnCancel_Click" IsCancel="True"/>
		</StackPanel>
	</Grid>
</local:StorableWindow>