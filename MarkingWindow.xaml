<local:StorableWindow x:Class="Labelman8.MarkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labelman8"
        mc:Ignorable="d"
        Title="Маркировка" Height="600" Width="800"
	    WindowStartupLocation="CenterOwner">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Панель с кнопками -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
			<Button x:Name="btnTypes" Content="Виды маркировки" Width="150" Height="30" Margin="5" Click="BtnTypes_Click"/>
			<Button x:Name="btnAdd" Content="Добавить маркировку" Width="150" Height="30" Margin="5" Click="BtnAdd_Click"/>
			<Button x:Name="btnPrint" Content="Печать" Width="150" Height="30" Margin="5" Click="BtnPrint_Click"/>
		</StackPanel>

		<!-- Основное содержимое (пока пусто) -->
		<Grid Grid.Row="1" Margin="10">
			<!-- Здесь позже будет список маркировки -->
		</Grid>
	</Grid>
</local:StorableWindow>
