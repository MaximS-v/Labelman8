<Window x:Class="Labelman8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приложение для печати" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
		Loaded="Window_Loaded">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель с кнопками -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
			<Button x:Name="btnExcel" 
                    Content="📂 Добавить файл *.xlsm со сводной спецификацией" 
                    Width="320" Height="40" 
                    Margin="0,0,10,0"
                    Click="BtnExcel_Click"/>

			<Button x:Name="btnPreparePrint" 
                    Content="📋 Шильдики" 
                    Width="160" Height="40" 
                    Margin="0,0,10,0"
                    Click="BtnPreparePrint_Click"
					IsEnabled="False"/>

			<Button x:Name="btnPackaging" 
                    Content="📦 Упаковка" 
                    Width="160" Height="40" 
                    Margin="0,0,10,0"
                    Click="BtnPackaging_Click"
					IsEnabled="False"/>

			<Button x:Name="btnMarking" 
                    Content="🏷️ Маркировка" 
                    Width="160" Height="40"
                    Click="BtnMarking_Click"
					IsEnabled="False"/>
		</StackPanel>

		<!-- DataGrid для отображения данных -->
		<DataGrid x:Name="dgData" 
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  AlternatingRowBackground="LightGray"
                  RowHeaderWidth="0"
                  Margin="0,0,0,10">
		</DataGrid>

		<!-- Нижняя панель со статусом -->
		<StatusBar Grid.Row="2">
			<StatusBarItem>
				<TextBlock x:Name="txtStatus" Text="Готов к работе" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<TextBlock x:Name="txtDbStatus" Text="БД: не подключено" Foreground="Gray" />
			</StatusBarItem>
		</StatusBar>
	</Grid>
</Window>