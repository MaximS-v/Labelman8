<local:StorableWindow x:Class="Labelman8.AddDeviceMarkingTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Labelman8"
        Title="Добавить вид маркировки для аппаратов" 
        Height="500" 
        Width="500"
        MinHeight="450"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
		SizeChanged="Window_SizeChanged">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Название -->
			<RowDefinition Height="Auto"/>
			<!-- Ширина -->
			<RowDefinition Height="Auto"/>
			<!-- Высота -->
			<RowDefinition Height="Auto"/>
			<!-- Шрифт -->
			<RowDefinition Height="Auto"/>
			<!-- Размер шрифта -->
			<RowDefinition Height="Auto"/>
			<!-- Текст -->
			<RowDefinition Height="Auto"/>
			<!-- Заголовок предпросмотра -->
			<RowDefinition Height="*"/>
			<!-- Область предпросмотра -->
			<RowDefinition Height="Auto"/>
			<!-- Кнопки -->
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Название -->
		<TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="0,5" Height="25" TextChanged="Txt_TextChanged"/>

		<!-- Ширина -->
		<TextBlock Grid.Row="1" Grid.Column="0" Text="Ширина (мм):" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtWidth" Grid.Row="1" Grid.Column="1" Margin="0,5" Height="25" Text="80" TextChanged="Txt_TextChanged"/>

		<!-- Высота -->
		<TextBlock Grid.Row="2" Grid.Column="0" Text="Высота (мм):" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtHeight" Grid.Row="2" Grid.Column="1" Margin="0,5" Height="25" Text="30" TextChanged="Txt_TextChanged"/>

		<!-- Шрифт -->
		<TextBlock Grid.Row="3" Grid.Column="0" Text="Шрифт:" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<ComboBox x:Name="cmbFont" Grid.Row="3" Grid.Column="1" Margin="0,5" Height="25" SelectionChanged="CmbFont_SelectionChanged">
			<ComboBoxItem Content="Arial" IsSelected="True"/>
			<ComboBoxItem Content="Calibri"/>
			<ComboBoxItem Content="Times New Roman"/>
			<ComboBoxItem Content="Verdana"/>
			<ComboBoxItem Content="Tahoma"/>
		</ComboBox>

		<!-- Размер шрифта -->
		<TextBlock Grid.Row="4" Grid.Column="0" Text="Размер шрифта:" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtFontSize" Grid.Row="4" Grid.Column="1" Margin="0,5" Height="25" Text="36" TextChanged="Txt_TextChanged"/>

		<!-- Текст для предпросмотра -->
		<TextBlock Grid.Row="5" Grid.Column="0" Text="Текст:" VerticalAlignment="Center" Margin="0,5,10,5"/>
		<TextBox x:Name="txtPreviewText" Grid.Row="5" Grid.Column="1" Margin="0,5" Height="25" Text="Образец текста" TextChanged="Txt_TextChanged"/>

		<!-- Заголовок области предпросмотра -->
		<TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Предпросмотр:" FontWeight="Bold" Margin="0,10,0,5"/>

		<!-- Область предпросмотра -->
		<Border Grid.Row="7" Grid.ColumnSpan="2" 
        BorderBrush="LightGray" 
        BorderThickness="1" 
        Background="WhiteSmoke"
        Margin="0,0,0,10"
        Padding="10"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        MinHeight="100"
        x:Name="previewContainer">

			<!-- Контейнер для наклейки -->
			<Border x:Name="stickerBorder"
            BorderBrush="Black" 
            BorderThickness="1" 
            Background="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

			<Image x:Name="stickerImage" 
				Stretch="None"
				RenderOptions.BitmapScalingMode="HighQuality"/>
			</Border>
		</Border>

		<!-- Кнопки -->
		<StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button x:Name="btnOk" Content="OK" Width="75" Height="25" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
			<Button x:Name="btnCancel" Content="Отмена" Width="75" Height="25" Click="BtnCancel_Click" IsCancel="True"/>
		</StackPanel>
	</Grid>
</local:StorableWindow>