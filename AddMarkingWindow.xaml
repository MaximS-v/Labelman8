<local:StorableWindow x:Class="Labelman8.AddMarkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Labelman8"
		xmlns:converters="clr-namespace:Labelman8.Converters"
        Title="Добавление маркировки" 
        Height="550" Width="600"
        WindowStartupLocation="CenterOwner">
	<local:StorableWindow.Resources>
		<converters:BoolToPlusMinusConverter x:Key="BoolToPlusMinusConverter"/>
	</local:StorableWindow.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Верхняя панель с кнопками -->
		<Grid Grid.Row="0" Margin="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Кнопка 1 -->
			<Button Grid.Column="0" MinHeight="30" Margin="5" Click="BtnAddDeviceType_Click">
				<TextBlock Text="Добавить вид маркировки для аппаратов" TextWrapping="Wrap" TextAlignment="Center"/>
			</Button>

			<!-- Кнопка 2 -->
			<Button Grid.Column="1" MinHeight="30" Margin="5" Click="BtnAddTerminalType_Click">
				<TextBlock Text="Добавить вид маркировки для клемм" TextWrapping="Wrap" TextAlignment="Center"/>
			</Button>

			<!-- Кнопка 3 -->
			<Button Grid.Column="2" MinHeight="30" Margin="5" Click="BtnEditType_Click">
				<TextBlock Text="Изменить вид маркировки" TextWrapping="Wrap" TextAlignment="Center"/>
			</Button>

			<!-- Кнопка 4 -->
			<Button Grid.Column="3" MinHeight="30" Margin="5" Click="BtnDeleteType_Click">
				<TextBlock Text="Удалить вид маркировки" TextWrapping="Wrap" TextAlignment="Center"/>
			</Button>
		</Grid>

		<!-- Заголовок таблицы "Аппараты" -->
		<TextBlock Grid.Row="1" Text="Аппараты" FontSize="16" FontWeight="Bold" Margin="10,10,10,5" HorizontalAlignment="Center"/>

		<!-- Таблица "Аппараты" -->
		<DataGrid x:Name="dgMarkingTypes" 
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="LightGray"
                  RowHeaderWidth="0"
                  Margin="10,0,10,10">

			<DataGrid.Columns>
				<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
				<DataGridTextColumn Header="Ширина" Binding="{Binding WidthMM}" Width="80"/>
				<DataGridTextColumn Header="Высота" Binding="{Binding HeightMM}" Width="80"/>
				<DataGridTextColumn Header="Шрифт" Binding="{Binding FontName}" Width="100"/>
				<DataGridTextColumn Header="Размер" Binding="{Binding DefaultFontSizePt}" Width="80"/>
				<DataGridTextColumn Header="Системный" Width="80">
					<DataGridTextColumn.Binding>
						<Binding Path="IsSystem" Converter="{StaticResource BoolToPlusMinusConverter}"/>
					</DataGridTextColumn.Binding>
				</DataGridTextColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Заголовок таблицы "Клеммы" -->
		<TextBlock Grid.Row="3" Text="Клеммы" FontSize="16" FontWeight="Bold" Margin="10,10,10,5" HorizontalAlignment="Center"/>

		<!-- Таблица "Клеммы" -->
		<DataGrid x:Name="dgTerminalMarkingTypes" 
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="LightGray"
                  RowHeaderWidth="0"
                  Margin="10,0,10,10">

			<DataGrid.Columns>
				<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
				<DataGridTextColumn Header="Высота" Binding="{Binding HeightMM}" Width="80"/>
				<DataGridTextColumn Header="Шаг" Binding="{Binding PitchMM}" Width="80"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- Нижняя панель -->
		<StackPanel Grid.Row="5" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
			<!-- Здесь позже могут быть кнопки управления -->
		</StackPanel>
	</Grid>
</local:StorableWindow>